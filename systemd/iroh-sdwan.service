[Unit]
Description=iroh SD-WAN FlowRouter data plane
After=network-online.target systemd-sysctl.service
Wants=network-online.target systemd-sysctl.service

[Service]
Type=simple
User=iroh-sdwan
Group=iroh-sdwan
ExecStartPre=+/bin/sh -ec 'chown root:iroh-sdwan /etc/iroh-sdwan; chmod 0750 /etc/iroh-sdwan; chown root:iroh-sdwan /etc/iroh-sdwan/config.toml /etc/iroh-sdwan/config.toml.blake3; chmod 0640 /etc/iroh-sdwan/config.toml /etc/iroh-sdwan/config.toml.blake3; for file in /var/lib/iroh-sdwan/identity.key /var/lib/iroh-sdwan/identity.key.derp; do if test -e "$file"; then chown iroh-sdwan:iroh-sdwan "$file"; chmod 0600 "$file"; fi; done'
ExecStartPre=/usr/local/bin/iroh-sdwan doctor --config /etc/iroh-sdwan/config.toml
ExecStart=/usr/local/bin/iroh-sdwand --config /etc/iroh-sdwan/config.toml --socket /run/iroh-sdwan/control.sock
ExecReload=/usr/local/bin/iroh-sdwan reload --socket /run/iroh-sdwan/control.sock
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
Environment=RUST_LOG=info
Environment=IROH_SDWAN_LOG_FORMAT=json
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iroh-sdwan
UMask=0077

CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/etc/iroh-sdwan /run/iroh-sdwan /var/lib/iroh-sdwan
StateDirectory=iroh-sdwan
StateDirectoryMode=0700
RuntimeDirectory=iroh-sdwan
RuntimeDirectoryMode=0770

[Install]
WantedBy=multi-user.target
